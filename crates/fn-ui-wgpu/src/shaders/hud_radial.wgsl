// HAND TRANSLATION of the cooked Slate pixel shader of M_HealProgress / CircularProgressBar (reports/hud-shaders/M_HealProgress/shader_5125.asm in the old tree):
// a radial wipe. Not generated by tools/gen_wgsl.cjs (the instruction list is 40 lines); pinned against `fn_ui::material::hud::radial_progress` by the
// `hud_radial_gpu_matches_cpu` test.
//   P[6].x = Percentage (cb1[2].x), tx0 = Texture (Results_TimerFill, clamp, sRGB), SelectionColor = 0 (cb1[1].xyz).
// The vertex tint (v1) is not used by this shader variant; the widget tint P[1] is applied by `finish` like for every material.
fn radial_angle(dx: f32, dy: f32) -> f32 {
    let ax = abs(dx);
    let ay = abs(dy);
    let big = max(ay, ax);
    if (big <= 0.0) { return 0.0; }
    let inv = 1.0 / big;
    let mn = min(ay, ax);
    let t = inv * mn;
    let t2 = t * t;
    var p = t2 * 0.020835 - 0.085133;
    p = t2 * p + 0.180141;
    p = t2 * p - 0.330299;
    p = t2 * p + 0.999866;
    let a = t * p;
    var z = a;
    if (ay < ax) { z = a + (a * -2.0 + 1.570796); }
    if (-dy < dy) { z = z + bitcast<f32>(0xc0490fdbu); }
    let nx = -dx;
    let ny = -dy;
    let mx = max(nx, ny);
    let mnn = min(nx, ny);
    if (mx >= -mx && mnn < -mnn) { return -z; }
    return z;
}
fn enc(c: f32) -> f32 {
    let v = max(c, 0.0);
    if (v >= 0.003131) { return 1.055 * pow(v, 0.416667) - 0.055; }
    return v * 12.92;
}
@fragment
fn fs_main(in: VOut) -> @location(0) vec4<f32> {
    let uv = in.lin;
    let x = radial_angle(uv.x - 0.5, uv.y - 0.5) * 0.159155;
    let m = floor(x - floor(x) + P[6].x);
    let t = tex_sample_0(uv.x, uv.y);
    let a = clamp(m * t.w, 0.0, 1.0);
    return finish(vec4<f32>(enc(t.x * m), enc(t.y * m), enc(t.z * m), a));
}
