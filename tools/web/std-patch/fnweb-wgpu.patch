+/// FNWEB (Fortnite 1.8 browser port): a render pipeline the browser is compiling ([`Device::fnweb_create_render_pipeline_async`]).
+#[cfg(webgpu)]
+pub struct PendingRenderPipeline {
+    state: alloc::rc::Rc<core::cell::RefCell<Option<Result<RenderPipeline, String>>>>,
+}
+#[cfg(webgpu)]
+impl PendingRenderPipeline {
+    /// `Some` once the browser is done: the pipeline, or its error (taken: later polls return `None`). `None` while it compiles.
+    pub fn poll(&self) -> Option<Result<RenderPipeline, String>> {
+        self.state.borrow_mut().take()
+    }
+}
