+    /// FNWEB (Fortnite 1.8 browser port; WebGPU backend only): [`Device::create_render_pipeline`] through `GPUDevice.createRenderPipelineAsync`.
+    /// The browser compiles the pipeline on its own worker threads (in parallel, without stalling the frames); poll the returned
+    /// [`PendingRenderPipeline`] (it resolves on the main thread's event loop) and only use the pipeline once it is there.
+    #[cfg(webgpu)]
+    pub fn fnweb_create_render_pipeline_async(&self, desc: &RenderPipelineDescriptor<'_>) -> PendingRenderPipeline {
+        let promise = self.inner.as_webgpu().fnweb_create_render_pipeline_async(desc);
+        let state: alloc::rc::Rc<core::cell::RefCell<Option<Result<RenderPipeline, String>>>> = alloc::rc::Rc::new(core::cell::RefCell::new(None));
+        let s = state.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            let r = match wasm_bindgen_futures::JsFuture::from(promise).await {
+                Ok(p) => Ok(RenderPipeline { inner: crate::backend::webgpu::fnweb_wrap_render_pipeline(p) }),
+                Err(e) => Err(alloc::format!("{e:?}")),
+            };
+            *s.borrow_mut() = Some(r);
+        });
+        PendingRenderPipeline { state }
+    }
